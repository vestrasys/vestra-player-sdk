{
  "name": "@vestra-player/sdk",
  "version": "1.1.0",
  "description": "Plugin API types, test host and plugin CLI for Vestra Player (apiVersion vestra/1)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vestrasys/vestra-player-sdk.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/plugin/testing.d.ts",
      "default": "./dist/plugin/testing.js"
    },
    "./runtime": {
      "types": "./dist/player-runtime.d.ts",
      "default": "./dist/player-runtime.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "vestra-plugin": "./bin/vestra-plugin.mjs"
  },
  "files": [
    "dist",
    "bin",
    "slint",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc -p tsconfig.check.json",
    "docs": "typedoc",
    "format": "prettier --write \"{src,test,bin,scripts}/**/*.{ts,mjs}\" package.json tsconfig.json tsconfig.check.json typedoc.json",
    "format:check": "prettier --check \"{src,test,bin,scripts}/**/*.{ts,mjs}\" package.json tsconfig.json tsconfig.check.json typedoc.json",
    "prepare": "node scripts/build.mjs",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@types/node": ">=22.18",
    "typescript": "^5.9.0"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "typedoc": "0.28.20"
  },
  "publishConfig": {
    "access": "public"
  }
}
