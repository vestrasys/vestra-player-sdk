// Command buttons of the bottom bar: the buttons
// that plugins' commands contribute (`commands.add({ button })`) and the
// player's own. The player draws
// the strip itself, at the right end of the bottom slot, its 40px cells on
// the slot's bottom edge (a bar's 40px button row), and also when no plugin
// mounts a bottom bar: `[plugin buttons…][»][Command Palette][Adjust]
// [Toggle Sidebar]`. A bottom bar places nothing: it lays its controls out left of
// the strip and says how wide they must stay:
//   import { BarButtonsHost } from "@vestra/bar-buttons.slint";
//   export component MyBar inherits Rectangle {
//       out property <length> content-min-width: ...; // the least your row needs
//       // your row ends at: root.width - BarButtonsHost.width - 4px
//   }
// The player gives its strip `bar width - content-min-width - 4px` (all of
// the width without `content-min-width`), so plugin buttons never cover
// what the bar needs (its time label, UI-BAR-10). Plugin buttons go left to
// right by ascending `order`, then plugin id, then registration; at most 8
// are in the strip, and the ones past 8 or past the room are in the `»`
// menu, in the same order: the lowest order stays longest. `»` shows only
// while something is in it; the player's own cells always show.
//
// `BarButtons` (below) is deprecated: the strip a bar placed itself. While a bar still places it, the player draws no second strip.
//
// The cells look like the bar's own icon buttons: a 32×32 plate on hover
// and press, the bar's tooltip (ToolTipArea). Every enabled cell draws its
// icon in the accent (accent-press while pressed; icon-disabled when
// disabled), so the strip reads as one group. A toggle that is on shows a
// small dot in the icon's colour centred under the icon, like a running app
// in the macOS Dock. They are persistent
// elements shown with `visible:`; nothing is created on hover or resize.
import { Theme } from "theme.slint";
import { Icon } from "icons.slint";
import { ToolTipArea } from "widgets.slint";

// One button as the player shows it.
export struct BarButtonItem {
    // What a click runs (the player's own token; "" for no button).
    token: string,
    // A name of @vestra/icons.slint, or "" for `image`.
    icon: string,
    // The plugin's image (`plugin.ui.image`), drawn in the icon colour.
    image: image,
    // The command's title (the accessibility label).
    label: string,
    // The tooltip: the title and its key, the reason it is unavailable.
    tip: string,
    enabled: bool,
    // The command has a checked state; `checked` shows the dot under the icon.
    checkable: bool,
    checked: bool,
    // At half opacity: on, but not shown for want of room (the sidebar).
    dimmed: bool,
}

// Filled by the player. A bar reads `width` (to end its own row left of
// the strip) and `fixed`; everything else is the player's.
export global BarButtonsHost {
    // The plugins' buttons for the strip, left to right, at most 8.
    in property <[BarButtonItem]> buttons;
    // How many plugin buttons are past those 8 (always in the `»` menu).
    in property <int> overflow;
    // The sidebar toggle (`token` "" while there is none).
    in property <BarButtonItem> toggle;
    // The command palette (`host/palette`; `token` "" while there is none).
    in property <BarButtonItem> palette;
    // The adjust column's toggle (`host/adjust`; `token` ""
    // while there is none).
    in property <BarButtonItem> adjust;
    // Set when a (deprecated) `BarButtons` exists in this window.
    in-out property <bool> placed;
    // The width the player gives its strip (the player sets it).
    in-out property <length> room;
    // The player's own cells, always shown: Command Palette, Adjust,
    // Toggle Sidebar.
    private property <int> own: (root.palette.token != "" ? 1 : 0) + (root.adjust.token != "" ? 1 : 0) + (root.toggle.token != "" ? 1 : 0);
    // The cells a bar must always leave free, 41px each: the player's own,
    // and the `»` cell whenever any plugin button exists (drawn only on
    // overflow, but always reserved, so `»` never covers the bar). Never
    // depends on `room`. A bar that keeps an optional control ahead of the
    // plugins' buttons counts it in `content-min-width` while it fits
    // beside these.
    out property <int> fixed: root.own + (root.buttons.length > 0 || root.overflow > 0 ? 1 : 0);
    // The strip's layout for a room, as pure functions, so the player's
    // strip binds them to its own `room` (no frame behind the shell's
    // layout) and the properties below give the same numbers for `room`.
    // The plugin buttons in the strip (the first of `buttons`) at `room`.
    public pure function shown-in(room: length) -> int {
        // Cells left for plugin buttons and `»`.
        let free = Math.max(0, Math.floor(room / 41px) - root.own);
        if root.overflow == 0 && root.buttons.length <= free {
            return root.buttons.length;
        }
        return Math.max(0, Math.min(root.buttons.length, free - 1));
    }
    // Whether `»` shows at `room` (a button past 8 or past the room).
    public pure function more-in(room: length) -> bool {
        return root.shown-in(room) < root.buttons.length || root.overflow > 0;
    }
    // The strip's width at `room` (0 while a bar places `BarButtons`).
    public pure function width-in(room: length) -> length {
        if root.placed {
            return 0px;
        }
        return (root.shown-in(room) + (root.more-in(room) ? 1 : 0) + root.own) * 41px;
    }
    out property <int> shown: root.shown-in(root.room);
    out property <bool> more: root.more-in(root.room);
    out property <length> width: root.width-in(root.room);
    // A click on the cell with this token.
    callback clicked(string);
}

// One 41×40 cell (the bar's BarButton). `shown`: on screen; a hidden cell
// is not actionable from the accessibility tree either.
component Cell inherits Rectangle {
    in property <BarButtonItem> item;
    in property <bool> shown;
    private property <bool> live: root.shown && root.item.enabled;
    private property <brush> tint: !root.item.enabled ? Theme.icon-disabled
        : touch.pressed ? Theme.accent-press : Theme.accent;
    // The on dot: its diameter and top edge, between the icon box (y 14–26)
    // and the hover plate's lower edge (y 36).
    private property <length> dot-size: 4px;
    private property <length> dot-y: 29px;
    width: 41px;
    height: 40px;
    visible: root.shown;
    opacity: root.item.dimmed ? 0.5 : 1;
    accessible-role: button;
    accessible-label: root.item.label;
    accessible-description: root.item.tip;
    accessible-enabled: root.live;
    accessible-checkable: root.item.checkable;
    accessible-checked: root.item.checked;
    accessible-action-default => { if root.live { BarButtonsHost.clicked(root.item.token); } }
    Rectangle {
        x: 4px;
        y: 4px;
        width: parent.width - 9px;
        height: parent.height - 8px;
        border-radius: Theme.radius-panel;
        background: !root.live ? transparent
            : touch.pressed ? Theme.press-bg
            : touch.has-hover ? Theme.hover-bg : transparent;
    }
    Icon {
        visible: root.item.icon != "";
        x: (root.width - 1px - self.width) / 2;
        y: (root.height - self.height) / 2;
        name: root.item.icon;
        color: root.tint;
    }
    // A plugin's image in the icon box (14×12), aspect kept, coloured like the icons.
    Image {
        visible: root.item.icon == "";
        x: (root.width - 1px - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: 14px;
        height: 12px;
        source: root.item.image;
        image-fit: contain;
        colorize: root.tint;
    }
    // On (`checked`): the dot under the icon, in the icon's colour.
    Rectangle {
        visible: root.item.checked;
        x: (root.width - 1px - self.width) / 2;
        y: root.dot-y;
        width: root.dot-size;
        height: root.dot-size;
        border-radius: self.width / 2;
        background: root.tint;
    }
    ToolTipArea {
        width: 100%;
        height: 100%;
        text: root.shown ? root.item.tip : "";
        touch := TouchArea {
            enabled: root.live;
            clicked => { BarButtonsHost.clicked(root.item.token); }
        }
    }
}

// Deprecated (the player places its strip): the strip a bar
// placed at its right end with the width it could spare. A bar that still
// places it shows this one instead of the player's (no palette cell, no
// `»`): the cells that fit in `room`, lost from its outer (left) end
// inward, the sidebar toggle last; it is as wide as the cells it shows.
export component BarButtons {
    // The width the bar can give the strip; the cells that fit show.
    in property <length> room;
    // The index (in the player's list, ascending order) of the leftmost
    // plugin button shown; the ones before it are hidden for want of room.
    out property <int> first-shown: BarButtonsHost.buttons.length - root.count;
    // The cells that fit in `room`.
    private property <int> fit: Math.max(0, Math.floor(root.room / 41px));
    private property <bool> toggle: BarButtonsHost.toggle.token != "" && root.fit >= 1;
    // The plugins' buttons shown: the highest orders, left of the toggle's cell.
    private property <int> count: Math.max(0, Math.min(BarButtonsHost.buttons.length, root.fit - (root.toggle ? 1 : 0)));
    width: (root.count + (root.toggle ? 1 : 0)) * 41px;
    height: 40px;
    init => { BarButtonsHost.placed = true; }
    Cell { x: (0 - root.first-shown) * 41px; shown: 0 >= root.first-shown && 0 < BarButtonsHost.buttons.length; item: BarButtonsHost.buttons[0]; }
    Cell { x: (1 - root.first-shown) * 41px; shown: 1 >= root.first-shown && 1 < BarButtonsHost.buttons.length; item: BarButtonsHost.buttons[1]; }
    Cell { x: (2 - root.first-shown) * 41px; shown: 2 >= root.first-shown && 2 < BarButtonsHost.buttons.length; item: BarButtonsHost.buttons[2]; }
    Cell { x: (3 - root.first-shown) * 41px; shown: 3 >= root.first-shown && 3 < BarButtonsHost.buttons.length; item: BarButtonsHost.buttons[3]; }
    Cell { x: (4 - root.first-shown) * 41px; shown: 4 >= root.first-shown && 4 < BarButtonsHost.buttons.length; item: BarButtonsHost.buttons[4]; }
    Cell { x: (5 - root.first-shown) * 41px; shown: 5 >= root.first-shown && 5 < BarButtonsHost.buttons.length; item: BarButtonsHost.buttons[5]; }
    Cell { x: (6 - root.first-shown) * 41px; shown: 6 >= root.first-shown && 6 < BarButtonsHost.buttons.length; item: BarButtonsHost.buttons[6]; }
    Cell { x: (7 - root.first-shown) * 41px; shown: 7 >= root.first-shown && 7 < BarButtonsHost.buttons.length; item: BarButtonsHost.buttons[7]; }
    Cell { x: root.count * 41px; shown: root.toggle; item: BarButtonsHost.toggle; }
}
