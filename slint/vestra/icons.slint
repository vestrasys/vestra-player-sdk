// The V-Line icon set (doc/product/ui-spec.md §2.4): round-capped, round-joined
// lines, 1.5px (1.25px for the small glyphs), never filled. The V of the
// logo recurs: « » for back and forward, ∧ ∨ for moving rows, a small V for
// every menu, list and scroll arrow.
//   import { Icon } from "@vestra/icons.slint";
//   Icon { name: "play"; color: Theme.text; }
// Each icon is drawn in its own box (`Icons.box-width` × `Icons.box-height`),
// which is also the Icon's default size; an unknown name draws nothing.
import { Theme } from "theme.slint";

export global Icons {
    // Path data in the icon's box.
    public pure function commands(name: string) -> string {
        if name == "play" { return "M 2.2 2.0 L 10.9 7 L 2.2 12.0 Z"; }
        if name == "pause" { return "M 1.75 1.75 H 4.5 V 12.25 H 1.75 Z M 7.5 1.75 H 10.25 V 12.25 H 7.5 Z"; }
        if name == "stop" { return "M 3.6 1.5 H 8.4 Q 10.5 1.5 10.5 3.6 V 8.4 Q 10.5 10.5 8.4 10.5 H 3.6 Q 1.5 10.5 1.5 8.4 V 3.6 Q 1.5 1.5 3.6 1.5 Z"; }
        if name == "back" { return "M 6.5 1.25 L 2.5 5 L 6.5 8.75 M 12 1.25 L 8 5 L 12 8.75"; }
        if name == "forward" { return "M 2 1.25 L 6 5 L 2 8.75 M 7.5 1.25 L 11.5 5 L 7.5 8.75"; }
        if name == "open" { return "M 1.5 3.2 Q 1.5 1.5 3.2 1.5 H 5.2 L 6.8 3.2 H 10.8 Q 12.5 3.2 12.5 4.9 V 8.8 Q 12.5 10.5 10.8 10.5 H 3.2 Q 1.5 10.5 1.5 8.8 Z"; }
        if name == "volume" { return "M 1 3.6 H 3 L 6 1.2 V 8.8 L 3 6.4 H 1 Z M 8.6 3.4 Q 9.7 5 8.6 6.6 M 10.6 1.6 Q 12.6 5 10.6 8.4"; }
        if name == "mute" { return "M 1 3.6 H 3 L 6 1.2 V 8.8 L 3 6.4 H 1 Z M 8.8 3.4 L 12 6.6 M 12 3.4 L 8.8 6.6"; }
        if name == "playlist" { return "M 1.25 1.5 H 11.75 M 1.25 5 H 11.75 M 1.25 8.5 H 6.5 M 9.2 7.2 L 10.5 8.5 L 11.8 7.2"; }
        if name == "detach" { return "M 5.5 1.5 H 3.3 Q 1.5 1.5 1.5 3.3 V 8.7 Q 1.5 10.5 3.3 10.5 H 8.7 Q 10.5 10.5 10.5 8.7 V 6.5 M 8.5 1.5 H 12.5 V 5.5 M 12.5 1.5 L 6.5 7.5"; }
        if name == "attach" { return "M 5.5 1.5 H 3.3 Q 1.5 1.5 1.5 3.3 V 8.7 Q 1.5 10.5 3.3 10.5 H 8.7 Q 10.5 10.5 10.5 8.7 V 6.5 M 12.5 1.5 L 7 7 M 7 3.5 V 7 H 10.5"; }
        if name == "close" { return "M 3.5 3 L 10.5 10 M 10.5 3 L 3.5 10"; }
        if name == "failed" { return "M 5 1.3 L 9.1 8.7 H 0.9 Z M 5 4.1 V 5.8 M 5 7.3 V 7.35"; }
        if name == "move-top" { return "M 2.5 1.75 H 11.5 M 3 9.75 L 7 5.75 L 11 9.75"; }
        if name == "move-up" { return "M 3 8 L 7 4 L 11 8"; }
        if name == "move-down" { return "M 3 4 L 7 8 L 11 4"; }
        if name == "move-bottom" { return "M 3 2.25 L 7 6.25 L 11 2.25 M 2.5 10.25 H 11.5"; }
        if name == "search" { return "M 9 5.25 A 3.75 3.75 0 1 1 1.5 5.25 A 3.75 3.75 0 1 1 9 5.25 Z M 8 8 L 11.25 10.75"; }
        if name == "chapter" { return "M 2.5 11 V 1.2 M 2.5 1.6 H 9.6 L 7.9 4.1 L 9.6 6.6 H 2.5"; }
        if name == "bookmark" { return "M 3.2 1.2 H 8.8 V 10.6 L 6 8.3 L 3.2 10.6 Z"; }
        if name == "check-task" { return "M 2.75 5.75 L 4.75 7.75 L 8.25 3.25"; }
        if name == "check-box" { return "M 1.5 4.75 L 3.6 6.75 L 7.5 2.25"; }
        if name == "menu-check" { return "M 4 7.25 L 6.25 9.5 L 10 4.75"; }
        if name == "submenu" { return "M 1.25 1.25 L 3.75 4 L 1.25 6.75"; }
        if name == "scroll-up" { return "M 1.25 3.75 L 4 1.25 L 6.75 3.75"; }
        if name == "scroll-down" { return "M 1.25 1.25 L 4 3.75 L 6.75 1.25"; }
        if name == "caret-down" { return "M 1.25 1.25 L 4 3.75 L 6.75 1.25"; }
        if name == "sort-asc" { return "M 1 3.25 L 3.5 0.75 L 6 3.25"; }
        if name == "sort-desc" { return "M 1 0.75 L 3.5 3.25 L 6 0.75"; }
        if name == "tag-remove" { return "M 1.5 1.5 L 5.5 5.5 M 5.5 1.5 L 1.5 5.5"; }
        if name == "preview-play" { return "M 1.5 1.3 L 6.9 4.5 L 1.5 7.7 Z"; }
        if name == "add" { return "M 5 1.5 V 8.5 M 1.5 5 H 8.5"; }
        if name == "remove" { return "M 1.5 5 H 8.5"; }
        if name == "sort" { return "M 3 1.5 V 8.5 M 1.2 6.7 L 3 8.5 L 4.8 6.7 M 7 8.5 V 1.5 M 5.2 3.3 L 7 1.5 L 8.8 3.3"; }
        return "";
    }
    // Line width.
    public pure function line(name: string) -> length {
        if name == "failed" || name == "chapter" || name == "bookmark" || name == "submenu" || name == "scroll-up" || name == "scroll-down" || name == "caret-down" || name == "tag-remove" || name == "preview-play" { return 1.25px; }
        if name == "sort-asc" || name == "sort-desc" { return 1.1px; }
        return 1.5px;
    }
    // The box the commands are drawn in.
    public pure function box-width(name: string) -> length {
        if name == "play" || name == "pause" || name == "stop" || name == "chapter" || name == "bookmark" { return 12px; }
        if name == "failed" || name == "add" || name == "remove" || name == "sort" { return 10px; }
        if name == "scroll-up" || name == "scroll-down" || name == "caret-down" || name == "preview-play" { return 8px; }
        if name == "volume" || name == "mute" || name == "playlist" { return 13px; }
        if name == "sort-asc" || name == "sort-desc" || name == "tag-remove" { return 7px; }
        if name == "check-task" { return 11px; }
        if name == "check-box" { return 9px; }
        if name == "submenu" { return 5px; }
        return 14px;
    }
    public pure function box-height(name: string) -> length {
        if name == "back" || name == "forward" || name == "volume" || name == "mute" || name == "playlist" || name == "failed" || name == "add" || name == "remove" || name == "sort" { return 10px; }
        if name == "play" || name == "pause" || name == "menu-check" { return 14px; }
        if name == "scroll-up" || name == "scroll-down" || name == "caret-down" { return 5px; }
        if name == "check-box" || name == "preview-play" { return 9px; }
        if name == "sort-asc" || name == "sort-desc" { return 4px; }
        if name == "close" { return 13px; }
        if name == "check-task" { return 11px; }
        if name == "submenu" { return 8px; }
        if name == "tag-remove" { return 7px; }
        return 12px;
    }
}

// One icon, stroked in `color`; scaled when the caller sets another size.
export component Icon {
    in property <string> name;
    in property <brush> color: Theme.text;
    width: Icons.box-width(root.name);
    height: Icons.box-height(root.name);
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: Icons.box-width(root.name) / 1px;
        viewbox-height: Icons.box-height(root.name) / 1px;
        commands: Icons.commands(root.name);
        stroke: root.color;
        stroke-width: Icons.line(root.name);
        stroke-line-cap: round;
        stroke-line-join: round;
    }
}
