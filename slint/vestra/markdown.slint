// Markdown display (store proposal §5):
//   import { MarkdownView, MarkdownBlocks, MarkdownBlock } from "@vestra/markdown.slint";
// Give `blocks` the value of `plugin.ui.markdown(text)`; the player parses
// the Markdown and fills the rows. Links report `link-clicked(url)` with the
// address resolved against the document's base; the plugin decides what to
// open (usually `plugin.system.openUrl`).
// `MarkdownView` scrolls one document. `MarkdownBlocks` does not scroll and
// is as tall as its content: put it in your own layout or in a `ListView`
// row (a chat message: a `[MarkdownBlock]` field of the row's struct).
// `code-copy: true` adds a Copy button to code blocks that reports
// `copy-code(code)`; the plugin copies it (`plugin.clipboard`).
// `selectable: true` lets the user select and copy text with the mouse:
// paragraphs, headings, list items and quotes without links then show their
// plain text (`MarkdownBlock.plain`, no inline styles) in a read-only text
// field, one field per block, with a Copy / Select All menu. A block with
// links keeps its styled text (links stay clickable); its right-click menu
// copies the block as plain text with each address after its link text,
// `text (url)`, and offers Copy Link when the block has one link. Code
// blocks are always selectable.
import { ListView, Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icon } from "icons.slint";

// One table row (cells are plain text).
export struct MarkdownRow {
    cells: [string],
    header: bool,
}

// One displayed block. Plugins only pass these through; the fields are
// filled by the player.
export struct MarkdownBlock {
    // "heading", "paragraph", "item", "code", "image", "table" or "rule".
    kind: string,
    // Heading level 1–6.
    level: int,
    // List nesting, 0–3.
    indent: int,
    // Block quote depth, 0–4.
    quote: int,
    // List marker ("•", "1."); empty for a continuation paragraph and for
    // task items.
    marker: string,
    // Task list item: 0 none, 1 open, 2 done (a drawn box, no font glyph).
    task: int,
    text: styled-text,
    // The block's text without styles, what `selectable` shows: a code
    // block's code, a table's cells (tab-separated lines), an image's alt.
    plain: string,
    code: string,
    image: image,
    has-image: bool,
    image-width: int,
    image-height: int,
    alt: string,
    // The addresses of the block's links, in order.
    links: [string],
    rows: [MarkdownRow],
    // Table column alignment: "left", "center", "right" or "" (left).
    aligns: [string],
}

// Read-only text the user can select: a right-click menu with Copy and
// Select All (as Slint's own text fields), and Ctrl+C / Ctrl+A (⌘C / ⌘A)
// while it has focus. No caret, as selectable text on a web page.
component SelectableText {
    in property <string> text;
    in property <brush> color: Theme.text;
    in property <length> font-size: Theme.font-tab;
    in property <int> font-weight: 400;
    in property <string> font-family;
    min-height: input.min-height;
    preferred-height: input.preferred-height;
    ContextMenuArea {
        Menu {
            MenuItem {
                title: @tr("Copy");
                enabled: root.text != "";
                activated => { input.copy(); }
            }
            MenuItem {
                title: @tr("Select All");
                enabled: root.text != "";
                activated => { input.select-all(); }
            }
        }
        input := TextInput {
            width: root.width;
            height: root.height;
            text: root.text;
            read-only: true;
            single-line: false;
            wrap: word-wrap;
            color: root.color;
            font-size: root.font-size;
            font-weight: root.font-weight;
            font-family: root.font-family;
            text-cursor-width: 0px;
            // The std-widgets LineEdit's selection colours, legible in both
            // palettes (as the info plugin's properties).
            selection-background-color: Palette.selection-background;
            selection-foreground-color: Palette.selection-foreground;
        }
    }
}

// A block with links in a selectable view: its styled text (links stay
// clickable) under a right-click menu that copies `plain` (with the
// addresses) and, for one link, the link. The menu lies above the text: a
// left click passes through it to the links.
component LinkText {
    in property <styled-text> text;
    in property <string> plain;
    in property <[string]> links;
    in property <brush> color: Theme.text;
    in property <length> font-size: Theme.font-tab;
    callback link-clicked(string);
    min-height: styled.min-height;
    preferred-height: styled.preferred-height;
    function put(text: string) {
        clip.text = text;
        clip.select-all();
        clip.copy();
    }
    styled := StyledText {
        width: root.width;
        height: root.height;
        text: root.text;
        default-color: root.color;
        default-font-size: root.font-size;
        link-color: Theme.accent;
        link-clicked(url) => { root.link-clicked(url); }
    }
    ContextMenuArea {
        Menu {
            MenuItem {
                title: @tr("Copy");
                activated => { root.put(root.plain); }
            }
            if root.links.length == 1: MenuItem {
                title: @tr("Copy Link");
                activated => { root.put(root.links[0]); }
            }
        }
    }
    // Puts text on the clipboard (Slint has no clipboard function).
    clip := TextInput {
        visible: false;
        width: 0px;
        height: 0px;
        read-only: true;
    }
}

component MarkdownBlockView {
    in property <MarkdownBlock> block;
    in property <length> available;
    in property <bool> code-copy;
    in property <bool> selectable;
    callback link-clicked(string);
    callback copy-code(string);
    private property <length> quote-indent: block.quote * 12px;
    private property <length> list-indent: block.indent * 16px;
    private property <length> inner: max(16px, root.available - root.quote-indent - root.list-indent);
    private property <length> heading-size: block.level <= 1 ? 18px : block.level == 2 ? 15px : block.level == 3 ? Theme.font-title : Theme.font-tab;

    HorizontalLayout {
        padding-left: root.quote-indent + root.list-indent;
        VerticalLayout {
            if block.kind == "heading" && root.selectable && block.links.length > 0: LinkText {
                width: root.inner;
                text: block.text;
                plain: block.plain;
                links: block.links;
                font-size: root.heading-size;
                link-clicked(url) => { root.link-clicked(url); }
            }
            if block.kind == "heading" && root.selectable && block.links.length == 0: SelectableText {
                width: root.inner;
                text: block.plain;
                font-size: root.heading-size;
                font-weight: 700;
            }
            if block.kind == "heading" && !root.selectable: StyledText {
                width: root.inner;
                text: block.text;
                default-color: Theme.text;
                default-font-size: root.heading-size;
                link-color: Theme.accent;
                link-clicked(url) => { root.link-clicked(url); }
            }
            if block.kind == "paragraph" && root.selectable && block.links.length > 0: LinkText {
                width: root.inner;
                text: block.text;
                plain: block.plain;
                links: block.links;
                color: block.quote > 0 ? Theme.text-dim : Theme.text;
                link-clicked(url) => { root.link-clicked(url); }
            }
            if block.kind == "paragraph" && root.selectable && block.links.length == 0: SelectableText {
                width: root.inner;
                text: block.plain;
                color: block.quote > 0 ? Theme.text-dim : Theme.text;
            }
            if block.kind == "paragraph" && !root.selectable: StyledText {
                width: root.inner;
                text: block.text;
                default-color: block.quote > 0 ? Theme.text-dim : Theme.text;
                default-font-size: Theme.font-tab;
                link-color: Theme.accent;
                link-clicked(url) => { root.link-clicked(url); }
            }
            if block.kind == "item": HorizontalLayout {
                spacing: 2px;
                if block.task == 0: Text {
                    width: 18px;
                    text: block.marker;
                    color: Theme.text-dim;
                    font-size: Theme.font-tab;
                    horizontal-alignment: right;
                }
                if block.task > 0: Rectangle {
                    width: 18px;
                    // The box sits on the first line of the item.
                    box := Rectangle {
                        x: parent.width - 13px;
                        y: 3px;
                        width: 11px;
                        height: 11px;
                        border-width: block.task == 2 ? 0px : 1px;
                        border-radius: 3px;
                        border-color: Theme.text-dim;
                        background: block.task == 2 ? Theme.accent : transparent;
                        if block.task == 2: Icon {
                            width: 100%;
                            height: 100%;
                            name: "check-task";
                            color: #ffffff;
                        }
                    }
                }
                if root.selectable && block.links.length > 0: LinkText {
                    width: root.inner - 20px;
                    text: block.text;
                    plain: block.plain;
                    links: block.links;
                    link-clicked(url) => { root.link-clicked(url); }
                }
                if root.selectable && block.links.length == 0: SelectableText {
                    width: root.inner - 20px;
                    text: block.plain;
                }
                if !root.selectable: StyledText {
                    width: root.inner - 20px;
                    text: block.text;
                    default-color: Theme.text;
                    default-font-size: Theme.font-tab;
                    link-color: Theme.accent;
                    link-clicked(url) => { root.link-clicked(url); }
                }
            }
            if block.kind == "code": Rectangle {
                background: Theme.bg-list;
                border-radius: Theme.radius-control;
                border-color: Theme.line;
                border-width: 1px;
                VerticalLayout {
                    padding: 6px;
                    // Plain lines in the monospace font; CJK falls back.
                    // Always selectable: code is there to be copied.
                    SelectableText {
                        width: root.inner - 12px;
                        text: block.code;
                        font-family: Theme.font-mono;
                        font-size: Theme.font-body;
                    }
                }
                if root.code-copy: Rectangle {
                    x: parent.width - self.width - 4px;
                    y: 4px;
                    width: copy-label.preferred-width + 12px;
                    height: Theme.button-small-height;
                    border-radius: Theme.radius-control;
                    background: copy-touch.pressed ? Theme.button-press : copy-touch.has-hover ? Theme.button-hover : Theme.button-bg;
                    copy-label := Text {
                        text: @tr("Copy");
                        color: copy-touch.has-hover ? Theme.text : Theme.text-dim;
                        font-size: Theme.font-body;
                        vertical-alignment: center;
                    }
                    copy-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.copy-code(block.code); }
                    }
                }
            }
            if block.kind == "image" && block.has-image: HorizontalLayout {
                alignment: start;
                Image {
                    source: block.image;
                    width: min(root.inner, block.image-width * 1px);
                    height: self.width * block.image-height / max(1, block.image-width);
                    image-fit: contain;
                }
            }
            if block.kind == "image" && !block.has-image: Text {
                text: block.alt == "" ? @tr("[Image]") : @tr("[Image] {}", block.alt);
                color: Theme.text-dim;
                font-size: Theme.font-body;
                wrap: word-wrap;
            }
            if block.kind == "table": table := Rectangle {
                border-color: Theme.line;
                border-width: 1px;
                property <int> columns: max(1, block.aligns.length);
                property <length> column-width: (root.inner - 8px - (self.columns - 1) * 8px) / self.columns;
                VerticalLayout {
                    for row in block.rows: Rectangle {
                        background: row.header ? Theme.bg-list : transparent;
                        HorizontalLayout {
                            padding-left: 4px;
                            padding-right: 4px;
                            padding-top: 2px;
                            padding-bottom: 2px;
                            spacing: 8px;
                            alignment: start;
                            // Equal columns in every row, aligned per the
                            // table's delimiter row (header and body alike).
                            for cell[i] in row.cells: Text {
                                width: max(0px, table.column-width);
                                horizontal-alignment: block.aligns[i] == "center" ? TextHorizontalAlignment.center : block.aligns[i] == "right" ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                                text: cell;
                                color: Theme.text;
                                font-size: Theme.font-body;
                                font-weight: row.header ? 700 : 400;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
            if block.kind == "rule": Rectangle {
                height: 1px;
                background: Theme.line;
            }
        }
    }
    // Quote bars, one per level, at the left edge.
    for level[i] in block.quote: Rectangle {
        x: i * 12px + 2px;
        y: 0px;
        width: 3px;
        height: root.height;
        background: Theme.line;
    }
}

// Markdown blocks without scrolling, as tall as their content.
export component MarkdownBlocks inherits Rectangle {
    in property <[MarkdownBlock]> blocks;
    // A Copy button on code blocks, reporting `copy-code(code)`.
    in property <bool> code-copy: false;
    // Text the user can select and copy (see the top of this file).
    in property <bool> selectable: false;
    callback link-clicked(string);
    callback copy-code(string);
    min-height: column.min-height;
    preferred-height: column.preferred-height;
    column := VerticalLayout {
        width: root.width;
        spacing: 8px;
        alignment: start;
        for block in root.blocks: MarkdownBlockView {
            block: block;
            available: root.width;
            code-copy: root.code-copy;
            selectable: root.selectable;
            link-clicked(url) => { root.link-clicked(url); }
            copy-code(code) => { root.copy-code(code); }
        }
    }
}

// A scrolling Markdown document: a `ListView` of its blocks, so only the
// blocks in view exist (a long document no longer builds every block). It
// draws as `MarkdownBlocks` in a column with `inset` padding would: `inset`
// above the first block, below the last and at both sides, 8px between.
export component MarkdownView inherits Rectangle {
    in property <[MarkdownBlock]> blocks;
    // Space around the document.
    in property <length> inset: 10px;
    // A Copy button on code blocks, reporting `copy-code(code)`.
    in property <bool> code-copy: false;
    // Text the user can select and copy (see the top of this file). A
    // selection is lost when its block scrolls out of view (the `ListView`
    // drops the row).
    in property <bool> selectable: false;
    callback link-clicked(string);
    callback copy-code(string);
    list := ListView {
        width: 100%;
        height: 100%;
        for block[i] in root.blocks: Rectangle {
            property <length> top: i == 0 ? root.inset : 0px;
            height: self.top + view.preferred-height
                + (i == root.blocks.length - 1 ? root.inset : 8px);
            view := MarkdownBlockView {
                x: root.inset;
                y: parent.top;
                width: max(0px, parent.width - 2 * root.inset);
                height: self.preferred-height;
                block: block;
                available: self.width;
                code-copy: root.code-copy;
                selectable: root.selectable;
                link-clicked(url) => { root.link-clicked(url); }
                copy-code(code) => { root.copy-code(code); }
            }
        }
    }
}
