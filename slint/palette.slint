// The player's colour palette (R-H6) and per-system fonts. Not part of the
// plugin library: the player sets these `in` properties on every view;
// `Theme` in @vestra/theme.slint reads them as `out` properties. Defaults:
// the Aurora colours of the `vestra` palette, the macOS fonts.
import { Palette } from "std-widgets.slint";

export global VestraPalette {
    in property <color> bg-bar: #16141c;
    in property <color> bg-video: #0a090e;
    in property <color> bg-list: #1a1821;
    in property <color> bg-panel: #201d28;
    in property <color> line: #2b2734;
    in property <color> hover-bg: #28232f;
    in property <color> press-bg: #110f16;
    in property <color> selected-bg: #2f2840;
    in property <color> text: #f5f3fa;
    in property <color> text-dim: #8e88a0;
    in property <color> text-list: #bdb8cb;
    in property <color> text-played: #6e6980;
    in property <color> accent: #f72aa6;
    in property <color> accent-press: #c41a83;
    in property <color> accent-disabled: #5a1d48;
    in property <color> icon-disabled: #3b3646;
    in property <color> playing: #2bb6ff;
    in property <color> button-bg: #2f2a3b;
    in property <color> button-hover: #3a3448;
    in property <color> button-press: #25202e;
    in property <color> button-disabled: #1b1922;
    // Errors and destructive actions (failed status, delete).
    in property <color> danger: #ff5a5f;
    // The system's monospace family (platform::monospace_font).
    in property <string> font-mono: "Menlo";
    // Each palette's progress gradient, logo amber → magenta → violet → cyan.
    // The player copies one into `accent-fill` (Slint's Rust API cannot
    // build gradients).
    out property <brush> fill-vestra: @linear-gradient(90deg, #fcc402 0%, #fb5a35 20%, #fa0aa8 45%, #7a0afa 72%, #10a8fc 100%);
    out property <brush> fill-vestra-light: @linear-gradient(90deg, #f5a700 0%, #f0442f 20%, #e0089a 45%, #6a08e8 72%, #0a95e6 100%);
    in property <brush> accent-fill: self.fill-vestra;
    // The std-widgets (fluent) controls follow the palette: the player sets
    // `light` for a light palette.
    in-out property <ColorScheme> color-scheme <=> Palette.color-scheme;
}
