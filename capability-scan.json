{
  "about": "The capability scan's table (docs/reference/scan.md): which API members and which requests of the player's protocol cross a boundary the user should know about, by category. Hand-maintained: every method of the public API and every method of the player's capability table is in exactly one list, a category's or none's (test/capability-scan.test.ts). `vestra-plugin scan` reports the categories a plugin uses. It changes nothing at run time: the manifest's capabilities gate the API as before.",
  "version": 1,
  "categories": {
    "player": {
      "about": "Changes the user's own player settings, or the player beyond what the plugin itself contributes: shortcuts, theme, language, rendering mode, a restart, mpv driven directly.",
      "members": [
        "Appearance.set",
        "Appearance.setLanguage",
        "Bindings.reset",
        "Bindings.set",
        "Mpv.command",
        "Mpv.set",
        "Rendering.restartPlayer",
        "Rendering.setPreference"
      ],
      "requests": [
        "appearance.set",
        "appearance.setLanguage",
        "bindings.reset",
        "bindings.set",
        "mpv.command",
        "mpv.set",
        "rendering.restart",
        "rendering.setPreference"
      ]
    },
    "plugins": {
      "about": "Acts on other plugins: installs, uninstalls, disables or reloads them, or runs any command, theirs included.",
      "members": [
        "Commands.run",
        "PackageCandidate.install",
        "Packages.reload",
        "Packages.setEnabled",
        "Packages.uninstall",
        "Packages.validate",
        "Packages.validateArchive"
      ],
      "requests": ["commands.run", "packages.*"]
    },
    "clipboard": {
      "about": "Reads or writes the system clipboard.",
      "members": [
        "Clipboard.readText",
        "Clipboard.writeImage",
        "Clipboard.writeText"
      ],
      "requests": [
        "clipboard.readText",
        "clipboard.writeImage",
        "clipboard.writeText"
      ]
    },
    "credentials": {
      "about": "Reads or writes sign-in details in the system keychain.",
      "members": ["Secrets.delete", "Secrets.get", "Secrets.set"],
      "requests": ["secrets.delete", "secrets.get", "secrets.set"]
    },
    "camera": {
      "about": "Uses a camera. No member of the API does today.",
      "members": [],
      "requests": []
    },
    "microphone": {
      "about": "Records from a microphone. No member of the API does today.",
      "members": [],
      "requests": []
    },
    "screen": {
      "about": "Captures the screen or other windows. No member of the API does today (a snapshot or an export is of the playing video).",
      "members": [],
      "requests": []
    },
    "notifications": {
      "about": "Shows system notifications. No member of the API does today (a message on the video is the plugin's own).",
      "members": [],
      "requests": []
    }
  },
