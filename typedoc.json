{
  "$schema": "https://typedoc.org/schema.json",
  "name": "@vestra-player/sdk",
  "entryPoints": ["src/index.ts", "src/plugin/testing.ts"],
  "tsconfig": "tsconfig.json",
  "out": "docs-site",
  "readme": "README.md",
  "projectDocuments": [
    "docs/{tutorials,concepts,how-to,examples}/index.md",
    "docs/{tutorials,concepts,how-to,examples}/!(index).md"
  ],
  "favicon": ".github/assets/logo.png",
  "excludeInternal": true,
  "excludePrivate": true,
  "includeVersion": true,
  "sort": ["source-order"],
  "groupOrder": ["Tutorials", "Concepts", "How-to", "Examples", "API", "*"],
  "categorizeByGroup": false,
  "defaultCategory": "Other",
  "navigation": {
    "includeCategories": true,
    "includeGroups": true,
    "includeFolders": false
  },
  "searchInComments": true,
  "searchInDocuments": true,
  "navigationLinks": {
    "GitHub": "https://github.com/vestrasys/vestra-player-sdk",
    "npm": "https://www.npmjs.com/package/@vestra-player/sdk",
    "llms.txt": "https://vestrasys.github.io/vestra-player-sdk/llms.txt"
  },
  "intentionallyNotExported": [
    "Filter",
    "MediaJob",
    "ResolvedResource",
    "Transport",
    "Call",
    "Handler",
    "SourceState",
    "PlaybackStats",
    "SubtitleState",
    "WireSystemInfo",
    "CommandDeclaration",
    "LayoutSlot"
  ],
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "rewrittenLink": true,
    "notDocumented": true,
    "unusedMergeModuleWith": true
  },
  "treatWarningsAsErrors": true,
  "treatValidationWarningsAsErrors": true,
  "ignoredHighlightLanguages": ["slint", "po"],
  "jsDocCompatibility": { "exampleTag": false },
  "plugin": [
    "typedoc-github-theme",
    "typedoc-plugin-mdn-links",
    "./scripts/typedoc-plugin.mjs"
  ]
}
