{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-control-regex": "off",
    "typescript/no-this-alias": "off",
    "unicorn/no-useless-spread": "off"
  },
  "ignorePatterns": [
    "dist/**",
    "docs-site/**",
    ".tmp/**",
    "examples/*/dist/**",
    "examples/*/node_modules/**"
  ]
}
